# ============================================================
# FRONTEND (Next.js en VPS) — Variables de entorno
# ============================================================

# YouTube Data API v3 — obtenla en https://console.cloud.google.com/
# Crea un proyecto → habilita "YouTube Data API v3" → Credenciales → API Key
# RESTRICCIÓN: en Google Cloud Console, restringe la key por IP del VPS
# (no por dominio del navegador — queremos que solo nuestro server la use)
YOUTUBE_API_KEY=

# URL pública del backend de la Pi 5 (detrás de Cloudflare Tunnel)
# Ejemplo: https://stream.tudominio.com
PI_STREAM_BASE=

# ============================================================
# BACKEND Pi 5 — Variables de entorno (ver pi-backend/.env)
# ============================================================
# Estas NO van aquí, van en /home/z/my-project/pi-backend/.env
