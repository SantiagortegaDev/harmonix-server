[Unit]
Description=Pi Stream Backend (FastAPI + yt-dlp)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=pi
WorkingDirectory=/home/pi/pi-stream
EnvironmentFile=/home/pi/pi-stream/.env
ExecStart=/home/pi/pi-stream/venv/bin/uvicorn main:app --host 127.0.0.1 --port 8000 --workers 1
Restart=on-failure
RestartSec=5s
StandardOutput=append:/home/pi/pi-stream/stream.log
StandardError=append:/home/pi/pi-stream/stream.log

# Seguridad — ojo: ProtectHome=read-only bloquea la DB SQLite.
# ReadWritePaths abre una excepción para el directorio del proyecto.
NoNewPrivileges=yes
ProtectSystem=full
ProtectHome=read-only
ReadWritePaths=/home/pi/pi-stream
PrivateTmp=yes

[Install]
WantedBy=multi-user.target
