# ============================================================
# Pi Stream Backend — Variables de entorno
# Copia este archivo a .env y edita los valores
# ============================================================

# Puerto donde escucha uvicorn (interna, Cloudflare Tunnel la expone)
LISTEN_PORT=8000

# TTL del cache en segundos (5h = 18000s). Las URLs de YouTube duran 6h.
CACHE_TTL=18000

# Rate limiting: máx extracciones por ventana. YouTube permite ~300/hora
RATE_LIMIT_WINDOW=3600
RATE_LIMIT_MAX=250

# CORS: dominios permitidos. Para producción pon tu dominio:
# ALLOWED_ORIGINS=https://app.tudominio.com,https://tudominio.com
ALLOWED_ORIGINS=*

# Cookies opcionales para yt-dlp (recomendado)
# Resuelve errores como "Sign in to confirm you're not a bot"
# El archivo debe llamarse cookies.txt y estar junto a main.py
# Para obtenerlo: extensión "Get cookies.txt LOCALLY" en tu navegador,
# inicia sesión en youtube.com (cuenta secundaria) y exporta.
# El script setup-pi.sh te pedirá pegar el contenido al instalar.
USE_COOKIES=false
