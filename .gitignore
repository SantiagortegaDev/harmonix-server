*.py[cod]
*$py.class
*.so
.Python
venv/
env/
ENV/
env.bak/
venv.bak/
.venv/
*.egg-info/
.pytest_cache/

# --- Database / Cache ---
*.db
*.db-journal
*.sqlite
*.sqlite3
